+namespace dxmt::cyderarchive {
+// Experimental graphics PSO cache only. Archives are local to this Mac/build.
+// Each PSO has its own archive: unrelated compilations never share a mutable
+// Metal archive or hold a global lock across compilation.
+// Bounded experimental cache. Use one process per cache directory.
+// A cache hit is accepted only when Metal verifies the exact pipeline.
+constexpr unsigned MaxFiles=4096;
+constexpr uint64_t Budget=256ULL*1024*1024, MaxEntry=8ULL*1024*1024;
+// Native Metal paths are UTF-8. Use Unicode extended Win32 paths for file
+// operations so non-ASCII usernames and long home directories work too.
+inline std::wstring winpath(const std::string &p) {
+  std::string z="Z:"+p; for(auto &c:z)if(c=='/')c='\\';
+  int n=MultiByteToWideChar(CP_UTF8,MB_ERR_INVALID_CHARS,z.data(),int(z.size()),nullptr,0);
+  if(!n)return {};
+  std::wstring out(size_t(n),L'\0');
+  MultiByteToWideChar(CP_UTF8,MB_ERR_INVALID_CHARS,z.data(),int(z.size()),out.data(),n);
+  return L"\\\\?\\"+out;
+}
+inline uint64_t size(const std::wstring &p) {
+  WIN32_FILE_ATTRIBUTE_DATA d{};
+  if(!GetFileAttributesExW(p.c_str(),GetFileExInfoStandard,&d) || (d.dwFileAttributes&FILE_ATTRIBUTE_DIRECTORY))return 0;
+  return (uint64_t(d.nFileSizeHigh)<<32)|d.nFileSizeLow;
+}
+// A digest is an integrity check, not an authenticity/security boundary.
+// Do not hand truncated or modified files to the driver archive parser.
+inline std::string digest_file(const std::wstring &path) {
+  HANDLE file=CreateFileW(path.c_str(),GENERIC_READ,FILE_SHARE_READ,nullptr,OPEN_EXISTING,0,nullptr);
+  if(file==INVALID_HANDLE_VALUE)return {};
+  LARGE_INTEGER length{};
+  if(!GetFileSizeEx(file,&length)||length.QuadPart<=0||uint64_t(length.QuadPart)>MaxEntry){CloseHandle(file);return {};}
+  Sha1HashState hash;char buffer[65536];uint64_t remaining=length.QuadPart;
+  while(remaining){
+    DWORD read=0,want=DWORD(std::min<uint64_t>(remaining,sizeof(buffer)));
+    if(!ReadFile(file,buffer,want,&read,nullptr)||read!=want){CloseHandle(file);return {};}
+    hash.update(buffer,read);remaining-=read;
+  }
+  CloseHandle(file);return hash.final().string();
+}
+inline bool verified(const std::wstring &path) {
+  auto digest=digest_file(path);if(digest.empty())return false;
+  auto receipt=path+L".sha1";
+  if(size(receipt)!=40)return false;
+  HANDLE file=CreateFileW(receipt.c_str(),GENERIC_READ,FILE_SHARE_READ,nullptr,OPEN_EXISTING,0,nullptr);
+  if(file==INVALID_HANDLE_VALUE)return false;
+  char expected[40];DWORD read=0;
+  bool ok=ReadFile(file,expected,40,&read,nullptr)&&read==40&&digest==std::string(expected,40);
+  CloseHandle(file);return ok;
+}
+inline bool write_digest(const std::wstring &path,const std::string &digest) {
+  if(digest.size()!=40)return false;
+  HANDLE file=CreateFileW(path.c_str(),GENERIC_WRITE,0,nullptr,CREATE_ALWAYS,0,nullptr);
+  if(file==INVALID_HANDLE_VALUE)return false;
+  DWORD written=0;bool ok=WriteFile(file,digest.data(),40,&written,nullptr)&&written==40;
+  CloseHandle(file);return ok;
+}
+struct Store {
+  std::string directory;
+  std::mutex publish_mutex;
+  uint64_t bytes=0;
+  unsigned files=0;
+  std::atomic<unsigned> logs{0};
+  Store() {
+    auto exe=env::getExeBaseName();
+    if(exe!="MapleStory" && exe!="cyder-pipeline-probe")return;
+    directory=env::getEnvVar("DXMT_CYDER_PIPELINE_CACHE");
+    if(directory.empty()||directory[0]!='/'){directory.clear();return;}
+    WIN32_FIND_DATAW data{};
+    HANDLE h=FindFirstFileW(winpath(directory+"/*.metalarc").c_str(),&data);
+    if(h!=INVALID_HANDLE_VALUE){do {
+      if(!(data.dwFileAttributes&FILE_ATTRIBUTE_DIRECTORY)){
+        bytes+=(uint64_t(data.nFileSizeHigh)<<32)|data.nFileSizeLow;files++;
+      }
+    }while(FindNextFileW(h,&data));FindClose(h);}
+  }
+  void report(const char *kind,const std::string &key) {
+    if(logs.fetch_add(1)<128)std::fprintf(stderr,"CYDER_PSO %s %s\n",kind,key.c_str());
+  }
+};
+inline Store& store(){static auto s=new Store;return *s;}
+
+inline Sha1Digest key(WMT::Device device,const WMTRenderPipelineInfo &i,
+                       const Sha1Digest &vs,const Sha1Digest &ps) {
+  Sha1HashState h;h.update(DXMT_VERSION, sizeof(DXMT_VERSION)-1);h.update(vs);h.update(ps);
+  h.update(device.registryID());
+  uint64_t major=0,minor=0,patch=0;WMTGetOSVersion(&major,&minor,&patch);
+  h.update(major);h.update(minor);h.update(patch);
+  // Explicit fields: never hash padding, pointers, or ephemeral Metal handles.
+  for(auto &c:i.colors){h.update(c.pixel_format);h.update(c.alpha_blend_operation);h.update(c.rgb_blend_operation);
+    h.update(c.src_rgb_blend_factor);h.update(c.dst_rgb_blend_factor);h.update(c.src_alpha_blend_factor);
+    h.update(c.dst_alpha_blend_factor);h.update(c.write_mask);h.update(c.blending_enabled);}
+  h.update(i.alpha_to_coverage_enabled);h.update(i.logic_operation_enabled);h.update(i.logic_operation);
+  h.update(i.rasterization_enabled);h.update(i.raster_sample_count);h.update(i.depth_pixel_format);h.update(i.stencil_pixel_format);
+  h.update(i.immutable_vertex_buffers);h.update(i.immutable_fragment_buffers);h.update(i.input_primitive_topology);
+  h.update(i.tessellation_partition_mode);h.update(i.max_tessellation_factor);h.update(i.tessellation_output_winding_order);h.update(i.tessellation_factor_step);
+  return h.final();
+}
+struct Pending {
+  WMT::Reference<WMT::BinaryArchive> archive;
+  std::string path;
+  // Called by the compilation worker AFTER ready/notify, never the render
+  // thread. The scheduler is joined before pipelines are destroyed.
+  void save() {
+    if(!archive || path.empty())return;
+    auto pool=WMT::MakeAutoreleasePool();
+    auto held=std::move(archive);auto &s=store();
+    auto temp=path+"."+std::to_string(GetCurrentProcessId())+"."+std::to_string(GetCurrentThreadId())+".tmp";
+    WMT::Error error;
+    held.serialize(temp.c_str(),error);
+    auto wtemp=winpath(temp),wpath=winpath(path);auto length=size(wtemp);
+    auto digest=digest_file(wtemp);
+    auto digest_temp=wtemp+L".sha1";
+    bool have_digest=write_digest(digest_temp,digest);
+    bool saved=false;
+    const char *reason=error?"serialization-error":!length?"missing-temp-file":length>MaxEntry?"entry-limit":"publish-error";
+    if(!error && length && length<=MaxEntry && have_digest){
+      std::lock_guard<std::mutex> lock(s.publish_mutex);
+      uint64_t old=size(wpath);
+      if(s.bytes>=old && s.bytes-old+length<=Budget && (old||s.files<MaxFiles)){
+        saved=MoveFileExW(wtemp.c_str(),wpath.c_str(),MOVEFILE_REPLACE_EXISTING)!=0;
+        if(saved){
+          s.bytes=s.bytes-old+length;if(!old)s.files++;
+          saved=MoveFileExW(digest_temp.c_str(),(wpath+L".sha1").c_str(),MOVEFILE_REPLACE_EXISTING)!=0;
+        }
+      } else reason=s.bytes>=old && s.bytes-old+length>Budget?"byte-limit":"file-limit";
+    }
+    if(!saved)DeleteFileW(wtemp.c_str());
+    DeleteFileW(digest_temp.c_str());
+    s.report(saved?"saved":reason,path.substr(path.find_last_of('/')+1));
+    path.clear();
+  }
+};
+inline WMT::Reference<WMT::RenderPipelineState> create(
+    WMT::Device device,WMTRenderPipelineInfo info,const Sha1Digest &vs,const Sha1Digest &ps,
+    WMT::Error &error,Pending &pending) {
+  // The v0.80 bridge returns autoreleased NSError pointers (+0).
+  // Local errors are borrowed; only the caller's owning Reference gets +1.
+  auto pool=WMT::MakeAutoreleasePool();
+  auto &s=store();
+  if(s.directory.empty()){
+    WMT::Error borrowed;
+    auto result=device.newRenderPipelineState(info,borrowed);
+    if(borrowed)borrowed.retain();error=borrowed;
+    return result;
+  }
+  auto digest=key(device,info,vs,ps).string();auto path=s.directory+"/"+digest+".metalarc";
+  auto length=size(winpath(path));
+  if(length && length<=MaxEntry && verified(winpath(path))){
+    WMT::Error load_error;
+    auto archive=device.newBinaryArchive(path.c_str(),load_error);
+    if(archive && !load_error){
+      obj_handle_t handle=archive.handle;
+      info.binary_archives_for_lookup.set(&handle);info.num_binary_archives_for_lookup=1;
+      info.fail_on_binary_archive_miss=true;
+      WMT::Error hit_error;
+      auto hit=device.newRenderPipelineState(info,hit_error);
+      if(hit && !hit_error){
+        s.report("hit",digest);return hit;
+      }
+    }
+  }
+  s.report("miss",digest);
+  info.binary_archives_for_lookup.set(nullptr);info.num_binary_archives_for_lookup=0;info.fail_on_binary_archive_miss=false;
+  bool can_save;
+  {std::lock_guard<std::mutex> lock(s.publish_mutex);can_save=s.bytes<Budget && s.files<MaxFiles;}
+  WMT::Error archive_error;
+  WMT::Reference<WMT::BinaryArchive> fresh;
+  if(can_save)fresh=device.newBinaryArchive(nullptr,archive_error);
+  if(fresh && !archive_error)info.binary_archive_for_serialization=fresh.handle;
+  WMT::Error borrowed;
+  auto result=device.newRenderPipelineState(info,borrowed);
+  if(!result && info.binary_archive_for_serialization){
+    // An optional cache must never prevent normal pipeline creation.
+    borrowed.handle=0;
+    info.binary_archive_for_serialization=0;
+    result=device.newRenderPipelineState(info,borrowed);fresh={};
+  }
+  if(borrowed)borrowed.retain();error=borrowed;
+  if(result && !error && fresh){pending.archive=std::move(fresh);pending.path=path;}
+  return result;
+}
+} // namespace dxmt::cyderarchive
