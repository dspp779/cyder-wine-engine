+    uint64_t begin = 0;
+    DWORD error;
+    HRESULT hr;
+    if (primary_write)
+    {
+        error = GetLastError();
+        begin = cyder_ddraw_profile_begin();
+        SetLastError(error);
+    }
+    hr = cyder_ddraw_update_frontbuffer_impl(surface, rect, read, swap_interval);
+    if (begin)
+    {
+        error = GetLastError();
+        cyder_ddraw_profile_record(surface, swapped ? NULL : rect, begin, hr);
+        SetLastError(error);
+    }
+    return hr;
+}
