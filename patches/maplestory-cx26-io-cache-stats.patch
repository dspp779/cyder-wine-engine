+static BOOL cyder_maplestory_file_cache_fill_mmap(
+    struct cyder_maplestory_file_cache_entry *entry, int fd, off_t window_offset,
+    size_t window_size, ssize_t *result )
+{
+#ifdef HAVE_SYS_MMAN_H
+    struct stat st;
+    long page_size;
+    off_t map_offset;
+    size_t delta, map_size, available;
+    void *map_base;
+
+    page_size = sysconf( _SC_PAGESIZE );
+    if (page_size <= 0 || fstat( fd, &st ) == -1) return FALSE;
+    map_offset = window_offset - window_offset % page_size;
+    delta = window_offset - map_offset;
+    if (st.st_size <= map_offset || (uintmax_t)(st.st_size - map_offset) <= delta)
+    {
+        *result = 0;
+        return TRUE;
+    }
+    available = st.st_size - map_offset;
+    map_size = min( available, delta + window_size );
+
+    cyder_maplestory_file_cache_unmap( entry );
+    map_base = mmap( NULL, map_size, PROT_READ, MAP_PRIVATE, fd, map_offset );
+    if (map_base == MAP_FAILED) return FALSE;
+
+    entry->map_base = map_base;
+    entry->map_size = map_size;
+    entry->map_offset = map_offset;
+    *result = map_size > delta ? map_size - delta : 0;
+    if (*result > window_size) *result = window_size;
+    if (*result) memcpy( entry->data, (char *)map_base + delta, *result );
+    return TRUE;
+#else
+    return FALSE;
+#endif
+}
