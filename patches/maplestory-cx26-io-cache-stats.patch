+static void cyder_maplestory_io_summary_record_cache_locked(
+    const struct cyder_maplestory_file_cache_entry *entry, unsigned int kind,
+    ssize_t bytes, unsigned long long duration, BOOL failure )
+{
+    struct cyder_maplestory_io_summary *summary;
+
+    if (!cyder_maplestory_io_cache_stats_enabled() || !cyder_maplestory_io_ring_armed ||
+        !entry || !entry->path[0]) return;
+
+    summary = cyder_maplestory_io_summary_find_locked( entry->path );
+    if (!summary)
+    {
+        summary = cyder_maplestory_io_summary_slot_locked();
+        if (!summary)
+        {
+            cyder_maplestory_io_summary_dropped++;
+            return;
+        }
+        memset( summary, 0, sizeof(*summary) );
+        summary->used = TRUE;
+        snprintf( summary->path, sizeof(summary->path), "%s", entry->path );
+    }
+
+    switch (kind)
+    {
+    case CYDER_MAPLESTORY_IO_CACHE_ATTEMPT:
+        cyder_maplestory_io_cache_attempts++;
+        break;
+    case CYDER_MAPLESTORY_IO_CACHE_HIT:
+        summary->cache_hits++;
+        break;
+    case CYDER_MAPLESTORY_IO_CACHE_FILL:
+        summary->cache_fills++;
+        if (bytes > 0) summary->cache_fill_bytes += bytes;
+        summary->cache_fill_dur_us += duration;
+        if (failure) summary->cache_fill_failures++;
+        break;
+    case CYDER_MAPLESTORY_IO_CACHE_BYPASS:
+        summary->cache_bypass_reads++;
+        break;
+    case CYDER_MAPLESTORY_IO_CACHE_SKIP_NEEDS_CLOSE:
+        summary->cache_skipped_needs_close++;
+        break;
+    }
+}
