+static void cyder_maplestory_io_cache_record_decision( unsigned int kind )
+{
+    if (!cyder_maplestory_io_cache_stats_enabled()) return;
+    pthread_mutex_lock( &cyder_maplestory_file_cache_mutex );
+    if (cyder_maplestory_io_ring_armed)
+    {
+        switch (kind)
+        {
+        case CYDER_MAPLESTORY_IO_CACHE_ATTEMPT:
+            cyder_maplestory_io_cache_attempts++;
+            break;
+        case CYDER_MAPLESTORY_IO_CACHE_SKIP_NEEDS_CLOSE:
+            cyder_maplestory_io_cache_skipped_needs_close++;
+            break;
+        case CYDER_MAPLESTORY_IO_CACHE_SKIP_NO_ENTRY:
+            cyder_maplestory_io_cache_skipped_no_entry++;
+            break;
+        case CYDER_MAPLESTORY_IO_CACHE_SKIP_NO_OFFSET:
+            cyder_maplestory_io_cache_skipped_no_offset++;
+            break;
+        }
+    }
+    pthread_mutex_unlock( &cyder_maplestory_file_cache_mutex );
+}
