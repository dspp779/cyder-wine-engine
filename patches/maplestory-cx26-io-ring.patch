+void cyder_maplestory_io_ring_dump(void)
+{
+    unsigned int i, start;
+
+    pthread_mutex_lock( &cyder_maplestory_file_cache_mutex );
+    if (cyder_maplestory_io_ring_dumped || !cyder_maplestory_io_ring_events ||
+        !cyder_maplestory_io_ring_count)
+    {
+        pthread_mutex_unlock( &cyder_maplestory_file_cache_mutex );
+        return;
+    }
+    cyder_maplestory_io_ring_dumped = TRUE;
+
+    TRACE_(cyderio)( "CYDER_IO ring count=%u dropped=%llu capacity=%u\n",
+                     cyder_maplestory_io_ring_count, cyder_maplestory_io_ring_dropped,
+                     CYDER_MAPLESTORY_IO_RING_EVENTS );
+    start = (cyder_maplestory_io_ring_next + CYDER_MAPLESTORY_IO_RING_EVENTS -
+             cyder_maplestory_io_ring_count) % CYDER_MAPLESTORY_IO_RING_EVENTS;
+    for (i = 0; i < cyder_maplestory_io_ring_count; i++)
+    {
+        const struct cyder_maplestory_io_ring_event *event =
+            &cyder_maplestory_io_ring_events[(start + i) % CYDER_MAPLESTORY_IO_RING_EVENTS];
+        const char *kind = event->kind == CYDER_MAPLESTORY_IO_RING_NTREAD ? "ntread" : "host";
+
+        TRACE_(cyderio)( "CYDER_IO ring seq=%u kind=%s t=%llu h=%p fd=%d off=%lld len=%u "
+                         "ret=%lld dur_us=%llu path=%s\n",
+                         i, kind, event->timestamp, event->handle, event->fd,
+                         (long long)event->offset, event->length, event->result,
+                         event->duration, event->path );
+    }
+    pthread_mutex_unlock( &cyder_maplestory_file_cache_mutex );
+}
+
+static void cyder_maplestory_io_ring_ensure_locked(void)
+{
+    if (!cyder_maplestory_io_ring_enabled() || cyder_maplestory_io_ring_events) return;
+    cyder_maplestory_io_ring_events = calloc( CYDER_MAPLESTORY_IO_RING_EVENTS,
+                                              sizeof(*cyder_maplestory_io_ring_events) );
+    if (!cyder_maplestory_io_ring_events) return;
+    if (!cyder_maplestory_io_ring_registered)
+    {
+        atexit( cyder_maplestory_io_ring_dump );
+        cyder_maplestory_io_ring_registered = TRUE;
+    }
+}
+
+static void cyder_maplestory_io_ring_record_locked(
+    unsigned int kind, HANDLE handle, int fd, off_t offset, ULONG length,
+    long long result, unsigned long long timestamp, unsigned long long duration,
+    const struct cyder_maplestory_file_cache_entry *entry )
+{
+    struct cyder_maplestory_io_ring_event *event;
+    char host_path[PATH_MAX];
+
+    cyder_maplestory_io_ring_ensure_locked();
+    if (!cyder_maplestory_io_ring_events) return;
+
+    event = &cyder_maplestory_io_ring_events[cyder_maplestory_io_ring_next];
+    if (cyder_maplestory_io_ring_count == CYDER_MAPLESTORY_IO_RING_EVENTS)
+        cyder_maplestory_io_ring_dropped++;
+    else
+        cyder_maplestory_io_ring_count++;
+    cyder_maplestory_io_ring_next = (cyder_maplestory_io_ring_next + 1) %
+        CYDER_MAPLESTORY_IO_RING_EVENTS;
+
+    event->timestamp = timestamp;
+    event->duration = duration;
+    event->handle = handle;
+    event->fd = fd;
+    event->offset = offset;
+    event->length = length;
+    event->result = result;
+    event->kind = kind;
+    if (entry && entry->path[0])
+        snprintf( event->path, sizeof(event->path), "%s", entry->path );
+#ifdef F_GETPATH
+    else if (fd >= 0 && !fcntl( fd, F_GETPATH, host_path ))
+        snprintf( event->path, sizeof(event->path), "%s", host_path );
+#endif
+    else
+        snprintf( event->path, sizeof(event->path), "?" );
+}
