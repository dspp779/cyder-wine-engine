+
+/* When sock->fd is replaced (accept_into / init_socket), sock-local async queues
+ * still hold weak async->fd pointers at the old object (see queue_async). Rebind
+ * them to new_fd before release_object(old_fd) so later async_terminate →
+ * fd_reselect_async does not hit a destroyed fd / NULL fd_ops (leave-game
+ * livelock under soft-guards, or SIGSEGV without). Marker: cyder: sock_rebind_async_fds */
+static void sock_rebind_async_fds( struct sock *sock, struct fd *old_fd, struct fd *new_fd )
+{
+    static const char cyder_sock_rebind_async_fd_marker[] __attribute__((used)) =
+        "cyder: sock_rebind_async_fds";
+
+    (void)cyder_sock_rebind_async_fd_marker;
+
+    if (!sock || !old_fd || old_fd == new_fd) return;
+
+    async_queue_rebind_fd( &sock->read_q, old_fd, new_fd );
+    async_queue_rebind_fd( &sock->write_q, old_fd, new_fd );
+    async_queue_rebind_fd( &sock->ifchange_q, old_fd, new_fd );
+    async_queue_rebind_fd( &sock->accept_q, old_fd, new_fd );
+    async_queue_rebind_fd( &sock->connect_q, old_fd, new_fd );
+    async_queue_rebind_fd( &sock->poll_q, old_fd, new_fd );
+}
