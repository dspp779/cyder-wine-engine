+/* Rebind weak async->fd pointers after an fd object is replaced.
+ * queue_async() releases the strong ref but keeps async->fd as a weak pointer
+ * (nulled only in free_async_queue). Sockets may replace sock->fd without
+ * destroying the sock-local queues, so update matching weak pointers to the
+ * new fd (no grab/release — still weak). */
+void async_queue_rebind_fd( struct async_queue *queue, struct fd *old_fd, struct fd *new_fd )
+{
+    struct async *async;
+
+    if (!queue || !old_fd || old_fd == new_fd) return;
+
+    LIST_FOR_EACH_ENTRY( async, &queue->queue, struct async, queue_entry )
+    {
+        if (async->fd == old_fd)
+            async->fd = new_fd;
+    }
+}
