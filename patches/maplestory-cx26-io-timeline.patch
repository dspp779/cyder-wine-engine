+static void cyder_maplestory_io_timeline_reset_locked(void)
+{
+    memset( cyder_maplestory_io_timeline, 0, sizeof(cyder_maplestory_io_timeline) );
+    cyder_maplestory_io_timeline_start = 0;
+    cyder_maplestory_io_timeline_dropped = 0;
+    cyder_maplestory_io_timeline_dumped = FALSE;
+}
+
+static void cyder_maplestory_io_timeline_record_locked(
+    unsigned int kind, ULONG length, long long result,
+    unsigned long long timestamp, unsigned long long duration )
+{
+    struct cyder_maplestory_io_timeline_bucket *bucket;
+    unsigned long long index;
+
+    if (!cyder_maplestory_io_timeline_enabled() || !timestamp) return;
+    if (!cyder_maplestory_io_timeline_start)
+        cyder_maplestory_io_timeline_start = timestamp;
+
+    index = timestamp >= cyder_maplestory_io_timeline_start ?
+        (timestamp - cyder_maplestory_io_timeline_start) / CYDER_MAPLESTORY_IO_TIMELINE_BUCKET_US : 0;
+    if (index >= CYDER_MAPLESTORY_IO_TIMELINE_BUCKETS)
+    {
+        cyder_maplestory_io_timeline_dropped++;
+        return;
+    }
+
+    bucket = &cyder_maplestory_io_timeline[index];
+    bucket->used = TRUE;
+    bucket->events++;
+    if (kind == CYDER_MAPLESTORY_IO_RING_NTREAD)
+    {
+        bucket->ntread_calls++;
+        bucket->ntread_bytes += length;
+    }
+    else
+    {
+        bucket->host_read_calls++;
+        if (result > 0) bucket->host_read_bytes += result;
+        if (result < 0) bucket->host_read_failures++;
+        bucket->host_read_dur_us += duration;
+    }
 }
 
+static void cyder_maplestory_io_timeline_dump_locked(void)
+{
+    unsigned int i, count = 0;
+
+    if (!cyder_maplestory_io_timeline_enabled() || cyder_maplestory_io_timeline_dumped)
+        return;
+    cyder_maplestory_io_timeline_dumped = TRUE;
+    for (i = 0; i < ARRAY_SIZE(cyder_maplestory_io_timeline); i++)
+        if (cyder_maplestory_io_timeline[i].used) count++;
+
+    TRACE_(cyderio)( "CYDER_IO timeline start_t=%llu bucket_us=%u count=%u dropped=%llu capacity=%u\n",
+                     cyder_maplestory_io_timeline_start, CYDER_MAPLESTORY_IO_TIMELINE_BUCKET_US,
+                     count, cyder_maplestory_io_timeline_dropped,
+                     CYDER_MAPLESTORY_IO_TIMELINE_BUCKETS );
+    for (i = 0; i < ARRAY_SIZE(cyder_maplestory_io_timeline); i++)
+    {
+        const struct cyder_maplestory_io_timeline_bucket *bucket = &cyder_maplestory_io_timeline[i];
+
+        if (!bucket->used) continue;
+        TRACE_(cyderio)( "CYDER_IO bucket index=%u t0=%llu events=%llu ntread=%llu ntbytes=%llu "
+                         "host=%llu hostbytes=%llu hostdur_us=%llu failures=%llu\n",
+                         i, cyder_maplestory_io_timeline_start +
+                         (unsigned long long)i * CYDER_MAPLESTORY_IO_TIMELINE_BUCKET_US,
+                         bucket->events, bucket->ntread_calls, bucket->ntread_bytes,
+                         bucket->host_read_calls, bucket->host_read_bytes,
+                         bucket->host_read_dur_us, bucket->host_read_failures );
+    }
+}
