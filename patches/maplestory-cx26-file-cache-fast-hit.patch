+static void cyder_maplestory_file_cache_tls_invalidate( HANDLE handle )
+{
+    if (cyder_maplestory_file_cache_tls_valid &&
+        cyder_maplestory_file_cache_tls.handle == handle)
+        cyder_maplestory_file_cache_tls_valid = FALSE;
+}
+
+static void cyder_maplestory_file_cache_tls_store(
+    HANDLE handle, int slot, unsigned long generation, off_t offset, size_t size,
+    const char *data )
+{
+    if (!cyder_maplestory_file_cache_fast_hit_enabled()) return;
+    if (size > sizeof(cyder_maplestory_file_cache_tls.data)) return;
+    cyder_maplestory_file_cache_tls.handle = handle;
+    cyder_maplestory_file_cache_tls.slot = slot;
+    cyder_maplestory_file_cache_tls.generation = generation;
+    cyder_maplestory_file_cache_tls.offset = offset;
+    cyder_maplestory_file_cache_tls.size = size;
+    memcpy( cyder_maplestory_file_cache_tls.data, data, size );
+    cyder_maplestory_file_cache_tls_valid = TRUE;
+}
+
+static void cyder_maplestory_file_cache_timing_add( unsigned long long *counter,
+                                                    unsigned long long delta )
+{
+    if (!delta || !cyder_maplestory_io_cache_timing_enabled()) return;
+    __sync_fetch_and_add( counter, delta );
