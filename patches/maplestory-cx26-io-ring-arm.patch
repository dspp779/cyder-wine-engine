+static BOOL cyder_maplestory_io_ring_control_arm_locked(void)
+{
+    const char *path;
+    struct stat st;
+    BOOL armed;
+
+    if (cyder_maplestory_io_ring_control_configured == -1)
+    {
+        path = getenv( "CYDER_MAPLESTORY_IO_RING_ARM_FILE" );
+        if (!path || !*path)
+        {
+            cyder_maplestory_io_ring_control_configured = 0;
+            cyder_maplestory_io_ring_armed = TRUE;
+        }
+        else
+        {
+            cyder_maplestory_io_ring_control_configured = 1;
+            snprintf( cyder_maplestory_io_ring_control_path,
+                      sizeof(cyder_maplestory_io_ring_control_path), "%s", path );
+            cyder_maplestory_io_ring_armed = !stat( cyder_maplestory_io_ring_control_path, &st );
+        }
+    }
+
+    if (!cyder_maplestory_io_ring_control_configured)
+        return TRUE;
+
+    if (!cyder_maplestory_io_ring_armed)
+    {
+        armed = !stat( cyder_maplestory_io_ring_control_path, &st );
+        if (armed && !cyder_maplestory_io_ring_armed)
+        {
+            cyder_maplestory_io_ring_next = 0;
+            cyder_maplestory_io_ring_count = 0;
+            cyder_maplestory_io_ring_dropped = 0;
+            cyder_maplestory_io_ring_dumped = FALSE;
+            TRACE_(cyderio)( "CYDER_IO ring armed t=%llu path=%s\n",
+                             cyder_maplestory_io_timestamp_us(),
+                             cyder_maplestory_io_ring_control_path );
+        }
+        cyder_maplestory_io_ring_armed = armed;
+    }
+    return cyder_maplestory_io_ring_armed;
 }
 
