+
+/* cyder: mono gs LastErrorValue
+ *
+ * On macOS %gs is the host pthread TSD area, not the TEB; only Self (0x30),
+ * ThreadLocalStoragePointer (0x58) and Peb (0x60) are mirrored there.  Unity
+ * Mono reads TEB.LastErrorValue inline as "mov r32, %gs:0x68" (for example in
+ * mono_marshal_set_last_error), so Marshal.GetLastWin32Error() returns host TSD
+ * garbage and managed file APIs throw.  Rewrite those reads (and the matching
+ * "mov r32, %gs:0x68" stores) in Mono DLLs into calls to thunks that access
+ * LastErrorValue through the real TEB pointer.  A load thunk only writes its
+ * destination register; no thunk changes the flags.
+ * CYDER_MONO_GS_LASTERROR=0 disables it.
+ */
+#define CYDER_GLE_THUNK(reg64, reg32) \
+    __ASM_GLOBAL_FUNC( cyder_mono_gle_##reg32, \
+                       "movq %gs:0x30,%" #reg64 "\n\t" \
+                       "movl 0x68(%" #reg64 "),%" #reg32 "\n\t" \
+                       "ret" )
+CYDER_GLE_THUNK(rax, eax)  CYDER_GLE_THUNK(rcx, ecx)  CYDER_GLE_THUNK(rdx, edx)  CYDER_GLE_THUNK(rbx, ebx)
+CYDER_GLE_THUNK(rbp, ebp)  CYDER_GLE_THUNK(rsi, esi)  CYDER_GLE_THUNK(rdi, edi)
+CYDER_GLE_THUNK(r8, r8d)   CYDER_GLE_THUNK(r9, r9d)   CYDER_GLE_THUNK(r10, r10d) CYDER_GLE_THUNK(r11, r11d)
+CYDER_GLE_THUNK(r12, r12d) CYDER_GLE_THUNK(r13, r13d) CYDER_GLE_THUNK(r14, r14d) CYDER_GLE_THUNK(r15, r15d)
+#undef CYDER_GLE_THUNK
+
+/* Mono also saves and restores the last error around helper calls with
+ * "mov %gs:0x68, r32 ... mov r32, %gs:0x68".  Once the reads are fixed, a
+ * restore must go to the TEB too: writing %gs:0x68 would overwrite the host
+ * gmtime() buffer pointer kept in that TSD slot.  The store thunks save one
+ * scratch register and leave the flags and every other register alone. */
+#define CYDER_GLS_THUNK(src32, scratch64) \
+    __ASM_GLOBAL_FUNC( cyder_mono_gls_##src32, \
+                       "pushq %" #scratch64 "\n\t" \
+                       "movq %gs:0x30,%" #scratch64 "\n\t" \
+                       "movl %" #src32 ",0x68(%" #scratch64 ")\n\t" \
+                       "popq %" #scratch64 "\n\t" \
+                       "ret" )
+CYDER_GLS_THUNK(eax, rcx)  CYDER_GLS_THUNK(ecx, rax)  CYDER_GLS_THUNK(edx, rax)  CYDER_GLS_THUNK(ebx, rax)
+CYDER_GLS_THUNK(ebp, rax)  CYDER_GLS_THUNK(esi, rax)  CYDER_GLS_THUNK(edi, rax)
+CYDER_GLS_THUNK(r8d, rax)  CYDER_GLS_THUNK(r9d, rax)  CYDER_GLS_THUNK(r10d, rax) CYDER_GLS_THUNK(r11d, rax)
+CYDER_GLS_THUNK(r12d, rax) CYDER_GLS_THUNK(r13d, rax) CYDER_GLS_THUNK(r14d, rax) CYDER_GLS_THUNK(r15d, rax)
+#undef CYDER_GLS_THUNK
+
+extern void cyder_mono_gls_eax(void), cyder_mono_gls_ecx(void), cyder_mono_gls_edx(void), cyder_mono_gls_ebx(void);
+extern void cyder_mono_gls_ebp(void), cyder_mono_gls_esi(void), cyder_mono_gls_edi(void);
+extern void cyder_mono_gls_r8d(void), cyder_mono_gls_r9d(void), cyder_mono_gls_r10d(void), cyder_mono_gls_r11d(void);
+extern void cyder_mono_gls_r12d(void), cyder_mono_gls_r13d(void), cyder_mono_gls_r14d(void), cyder_mono_gls_r15d(void);
+
+static void (*const cyder_mono_gls_thunks[16])(void) =
+{
+    cyder_mono_gls_eax, cyder_mono_gls_ecx, cyder_mono_gls_edx, cyder_mono_gls_ebx,
+    NULL /* esp */, cyder_mono_gls_ebp, cyder_mono_gls_esi, cyder_mono_gls_edi,
+    cyder_mono_gls_r8d, cyder_mono_gls_r9d, cyder_mono_gls_r10d, cyder_mono_gls_r11d,
+    cyder_mono_gls_r12d, cyder_mono_gls_r13d, cyder_mono_gls_r14d, cyder_mono_gls_r15d,
+};
+
+extern void cyder_mono_gle_eax(void), cyder_mono_gle_ecx(void), cyder_mono_gle_edx(void), cyder_mono_gle_ebx(void);
+extern void cyder_mono_gle_ebp(void), cyder_mono_gle_esi(void), cyder_mono_gle_edi(void);
+extern void cyder_mono_gle_r8d(void), cyder_mono_gle_r9d(void), cyder_mono_gle_r10d(void), cyder_mono_gle_r11d(void);
+extern void cyder_mono_gle_r12d(void), cyder_mono_gle_r13d(void), cyder_mono_gle_r14d(void), cyder_mono_gle_r15d(void);
+
+static void (*const cyder_mono_gle_thunks[16])(void) =
+{
+    cyder_mono_gle_eax, cyder_mono_gle_ecx, cyder_mono_gle_edx, cyder_mono_gle_ebx,
+    NULL /* esp */, cyder_mono_gle_ebp, cyder_mono_gle_esi, cyder_mono_gle_edi,
+    cyder_mono_gle_r8d, cyder_mono_gle_r9d, cyder_mono_gle_r10d, cyder_mono_gle_r11d,
+    cyder_mono_gle_r12d, cyder_mono_gle_r13d, cyder_mono_gle_r14d, cyder_mono_gle_r15d,
+};
+
+static BOOL cyder_is_mono_module( const UNICODE_STRING *nt_name )
+{
+    const WCHAR *p, *base = nt_name->Buffer;
+    USHORT len = nt_name->Length / sizeof(WCHAR), i;
+
+    for (i = 0; i < len; i++) if (nt_name->Buffer[i] == '\\') base = nt_name->Buffer + i + 1;
+    len -= base - nt_name->Buffer;
+    if (len < 8) return FALSE;  /* "mono.dll" */
+    if (wcsnicmp( base, L"mono", 4 )) return FALSE;
+    if (base[4] != '-' && base[4] != '.') return FALSE;  /* mono.dll, mono-2.0-*.dll */
+    p = base + len - 4;
+    return !wcsnicmp( p, L".dll", 4 );
+}
+
+/* Replacement for Mono's JIT emitter of OP_GET_LAST_ERROR (amd64, Windows),
+ * guint8 *emit_get_last_error( guint8 *code, int dreg ), which emits
+ * "mov dreg32, %gs:0x68" into every SetLastError P/Invoke wrapper.  Emit
+ *   mov dreg64, %gs:0x30 ; mov dreg32, 0x68(dreg64)
+ * instead (at most 14 bytes). */
+static unsigned char * WINAPI cyder_mono_emit_get_last_error( unsigned char *code, int dreg )
+{
+    unsigned int r = dreg & 7, hi = dreg >= 8;
+
+    *code++ = 0x65;                       /* %gs: */
+    *code++ = 0x48 | (hi ? 0x04 : 0);     /* REX.W (+R) */
+    *code++ = 0x8b;
+    *code++ = 0x04 | (r << 3);
+    *code++ = 0x25;
+    *code++ = 0x30; *code++ = 0; *code++ = 0; *code++ = 0;
+    if (hi) *code++ = 0x45;               /* REX.R + REX.B */
+    *code++ = 0x8b;
+    *code++ = 0x40 | (r << 3) | r;        /* mod=01: disp8 */
+    if (r == 4) *code++ = 0x24;           /* rsp/r12 base needs a SIB byte */
+    *code++ = 0x68;
+    return code;
+}
+
+/* Find Mono's emit_get_last_error and redirect it; returns TRUE when done.
+ * Matches the body "movb $0x65,(%rcx) ... movl $0x6825,0x2(%rcx); movb $0,0x6(%rcx); ret". */
+static BOOL cyder_patch_mono_last_error_emitter( unsigned char *start, unsigned char *end )
+{
+    static const unsigned char tail[] = { 0xc7, 0x41, 0x02, 0x25, 0x68, 0x00, 0x00, 0xc6, 0x41, 0x06, 0x00, 0xc3 };
+    unsigned char *p, *fn = NULL, *q;
+    unsigned int found = 0;
+    INT_PTR rel;
+
+    for (p = start + 0x40; p + sizeof(tail) <= end; p++)
+    {
+        if (memcmp( p, tail, sizeof(tail) )) continue;
+        for (q = p - 3; q >= p - 0x40; q--)
+            if (q[0] == 0xc6 && q[1] == 0x01 && q[2] == 0x65 && q[-1] == 0xcc) break;  /* movb $0x65,(%rcx) after padding */
+        if (q < p - 0x40) continue;
+        fn = q;
+        found++;
+    }
+    if (found != 1)
+    {
+        if (found) ERR( "cyder: %u candidate Mono last-error emitters, not patched\n", found );
+        return FALSE;
+    }
+    rel = (char *)cyder_mono_emit_get_last_error - (char *)(fn + 5);
+    if (rel != (INT32)rel)
+    {
+        ERR( "cyder: Mono last-error emitter out of jump range, not patched\n" );
+        return FALSE;
+    }
+    fn[0] = 0xe9;  /* jmp rel32 */
+    *(INT32 *)(fn + 1) = (INT32)rel;
+    return TRUE;
+}
+
+/* returns the number of rewritten sites */
+static unsigned int cyder_patch_mono_gs_last_error( void *module, IMAGE_NT_HEADERS *nt )
+{
+    IMAGE_SECTION_HEADER *sec = IMAGE_FIRST_SECTION( nt );
+    unsigned int count = 0, skipped = 0, s;
+
+    for (s = 0; s < nt->FileHeader.NumberOfSections; s++, sec++)
+    {
+        unsigned char *start = (unsigned char *)module + sec->VirtualAddress, *p, *end;
+        SIZE_T size = max( sec->Misc.VirtualSize, sec->SizeOfRawData );
+        void *addr = start;
+        ULONG old;
+
+        if (!(sec->Characteristics & IMAGE_SCN_MEM_EXECUTE) || size < 9) continue;
+        if (NtProtectVirtualMemory( NtCurrentProcess(), &addr, &size, PAGE_EXECUTE_READWRITE, &old )) continue;
+        end = start + max( sec->Misc.VirtualSize, sec->SizeOfRawData ) - 9;
+        for (p = start; p <= end; p++)
+        {
+            unsigned int rex = 0, reg, len;
+            void (*thunk)(void);
+            unsigned char *op;
+            INT_PTR rel;
+
+            if (p[0] != 0x65) continue;  /* %gs: */
+            op = p + 1;
+            if (*op == 0x44) { rex = 8; op++; }  /* REX.R: r8d..r15d */
+            if ((op[0] != 0x8b && op[0] != 0x89) || (op[1] & 0xc7) != 0x04 || op[2] != 0x25 ||
+                op[3] != 0x68 || op[4] || op[5] || op[6]) continue;  /* mov r32 <-> [disp32 0x68] */
+            reg = rex | ((op[1] >> 3) & 7);
+            len = (op + 7) - p;
+            thunk = op[0] == 0x8b ? cyder_mono_gle_thunks[reg] : cyder_mono_gls_thunks[reg];
+            if (!thunk) continue;
+            rel = (char *)thunk - (char *)(p + 5);
+            if (rel != (INT32)rel) { skipped++; continue; }
+            p[0] = 0xe8;  /* call rel32 */
+            *(INT32 *)(p + 1) = (INT32)rel;
+            if (len == 8) memcpy( p + 5, "\x0f\x1f\x00", 3 );          /* 3-byte nop */
+            else memcpy( p + 5, "\x0f\x1f\x40\x00", 4 );                /* 4-byte nop */
+            count++;
+            p += len - 1;
+        }
+        if (cyder_patch_mono_last_error_emitter( start, start + max( sec->Misc.VirtualSize, sec->SizeOfRawData ) ))
+        {
+            TRACE( "cyder: redirected Mono JIT last-error emitter\n" );
+            count++;
+        }
+        NtProtectVirtualMemory( NtCurrentProcess(), &addr, &size, old, &old );
+    }
+    if (count) NtFlushInstructionCache( NtCurrentProcess(), module, nt->OptionalHeader.SizeOfImage );
+    if (skipped) ERR( "cyder: %u Mono %%gs:0x68 reads out of call range, not patched\n", skipped );
+    return count;
+}
+
+static void cyder_fix_mono_last_error( void *module, IMAGE_NT_HEADERS *nt, const UNICODE_STRING *nt_name )
+{
+    static int enabled = -1;
+    unsigned int count;
+
+    if (!cyder_is_mono_module( nt_name )) return;
+    if (enabled == -1)
+    {
+        WCHAR buf[4];
+        UNICODE_STRING name = RTL_CONSTANT_STRING( L"CYDER_MONO_GS_LASTERROR" ), value;
+
+        value.Buffer = buf;
+        value.MaximumLength = sizeof(buf);
+        enabled = is_macos();
+        if (enabled && !RtlQueryEnvironmentVariable_U( NULL, &name, &value ) &&
+            value.Length == sizeof(WCHAR) && buf[0] == '0') enabled = 0;
+    }
+    if (!enabled) return;
+    count = cyder_patch_mono_gs_last_error( module, nt );
+    TRACE( "cyder: rewrote %u Mono %%gs:0x68 LastErrorValue read(s) in %s\n", count, debugstr_us(nt_name) );
+}
 #endif
 
