--- a/server/named_pipe.c
+++ b/server/named_pipe.c
@@ -473,17 +473,35 @@ static void pipe_end_disconnect( struct pipe_end *pipe_end, unsigned int status )
 
     pipe_end->state = status == STATUS_PIPE_DISCONNECTED
         ? FILE_PIPE_DISCONNECTED_STATE : FILE_PIPE_CLOSING_STATE;
-    fd_async_wake_up( pipe_end->fd, ASYNC_TYPE_WAIT, status );
-    async_wake_up( &pipe_end->read_q, status );
+    /* A pipe_end may still be alive with fd == NULL (init failure, or teardown
+     * races). fd_async_wake_up / set_fd_signaled would SIGSEGV at wait_q.
+     * async_wake_up(STATUS_PIPE_BROKEN) would still call is_fd_overlapped on a
+     * null/dangling async->fd — clear the queue the same way destroy does. */
+    if (!pipe_end->fd)
+    {
+        static int reported;
+
+        if (reported++ < 10)
+            wineserver_diag_printf( "wineserver: pipe_end_disconnect: null fd for pipe_end %p\n",
+                                    pipe_end );
+        free_async_queue( &pipe_end->read_q );
+    }
+    else
+    {
+        fd_async_wake_up( pipe_end->fd, ASYNC_TYPE_WAIT, status );
+        async_wake_up( &pipe_end->read_q, status );
+    }
     LIST_FOR_EACH_ENTRY_SAFE( message, next, &pipe_end->message_queue, struct pipe_message, entry )
     {
         async = message->async;
         if (async || status == STATUS_PIPE_DISCONNECTED) free_message( message );
         if (!async) continue;
+        /* Weak async->fd may outlive pipe_end->fd during teardown. */
+        if (!pipe_end->fd) async_clear_weak_fd( async );
         async_terminate( async, status );
         release_object( async );
     }
-    if (status == STATUS_PIPE_DISCONNECTED) set_fd_signaled( pipe_end->fd, 0 );
+    if (status == STATUS_PIPE_DISCONNECTED && pipe_end->fd) set_fd_signaled( pipe_end->fd, 0 );
 
     if (connection)
     {
@@ -1048,7 +1066,10 @@ static void reselect_read_queue( struct pipe_end *pipe_end, int reselect_write )
     if (pipe_end->connection)
     {
         if (list_empty( &pipe_end->message_queue ))
-            fd_async_wake_up( pipe_end->connection->fd, ASYNC_TYPE_WAIT, STATUS_SUCCESS );
+        {
+            if (pipe_end->connection->fd)
+                fd_async_wake_up( pipe_end->connection->fd, ASYNC_TYPE_WAIT, STATUS_SUCCESS );
+        }
         else if (reselect_write)
             reselect_write_queue( pipe_end->connection );
     }
