+/* H2 hit-path in-process prewarm: after arm, fill bounded Effect/Mob spans into
+ * the adaptive file-cache (and host page-cache via the same reads). Opt-in via
+ * CYDER_MAPLESTORY_FILE_CACHE_PREWARM_IN_PROCESS; arm via the same control file
+ * as CYDER_MAPLESTORY_IO_RING_ARM_FILE. Default total budget 32 MiB. */
+struct cyder_maplestory_file_cache_prewarm_target
+{
+    const char *path;
+    off_t offset;
+    unsigned int length;
+};
+
+static const struct cyder_maplestory_file_cache_prewarm_target
+    cyder_maplestory_file_cache_prewarm_targets[] =
+{
+    { "Data/Effect/Effect_000.wz", 0, 8 * 1024 * 1024 },
+    { "Data/Effect/_Canvas/_Canvas_003.wz", 0, 4 * 1024 * 1024 },
+    { "Data/Effect/_Canvas/_Canvas_053.wz", 0, 2 * 1024 * 1024 },
+    { "Data/Effect/_Canvas/_Canvas_041.wz", 0, 1 * 1024 * 1024 },
+    { "Data/Effect/_Canvas/_Canvas_052.wz", 0, 1 * 1024 * 1024 },
+    { "Data/Mob/_Canvas/_Canvas_001.wz", 0, 1 * 1024 * 1024 },
+    { "Data/Mob/_Canvas/_Canvas_000.wz", 0, 1 * 1024 * 1024 },
+    { "Data/Mob/_Canvas/_Canvas_075.wz", 0, 1 * 1024 * 1024 },
+    { "Data/Mob/_Canvas/_Canvas_071.wz", 0, 1 * 1024 * 1024 },
+    { "Data/Mob/_Canvas/_Canvas_079.wz", 0, 1 * 1024 * 1024 },
+    { "Data/Mob/_Canvas/_Canvas_079.wz", 92150703, 1 * 1024 * 1024 },
+    { "Data/Morph/Morph_000.wz", 0, 1 * 1024 * 1024 }
+};
+
+static BOOL cyder_maplestory_file_cache_prewarm_path_matches( const char *path,
+                                                               const char *suffix )
+{
+    size_t path_length, suffix_length;
+
+    if (!path || !*path || !suffix) return FALSE;
+    path_length = strlen( path );
+    suffix_length = strlen( suffix );
+    return path_length >= suffix_length &&
+        !strcasecmp( path + path_length - suffix_length, suffix );
 }
 
+static unsigned int cyder_maplestory_file_cache_prewarm_snapshot_locked(
+    const char *path, HANDLE *handles )
+{
+    unsigned int i, count = 0;
 
+    for (i = 0; i < ARRAY_SIZE(cyder_maplestory_file_cache) &&
+                count < ARRAY_SIZE(cyder_maplestory_file_cache); i++)
+    {
+        const struct cyder_maplestory_file_cache_entry *entry =
+            &cyder_maplestory_file_cache[i];
+        if (entry->eligible && entry->cacheable &&
+            cyder_maplestory_file_cache_prewarm_path_matches( entry->path, path ))
+        {
+            if (handles) handles[count] = entry->handle;
+            count++;
+        }
+    }
+    return count;
+}
+
+static BOOL cyder_maplestory_file_cache_prewarm_host_path(
+    const struct cyder_maplestory_file_cache_prewarm_target *target,
+    const char *root, unsigned int budget, unsigned int *used_bytes,
+    unsigned int *attempted, unsigned int *served )
+{
+    char path[PATH_MAX];
+    char data[CYDER_MAPLESTORY_FILE_CACHE_MIN_WINDOW];
+    off_t read_offset, end;
+    unsigned long long start, duration;
+    unsigned int requests = 0, total_bytes = 0, span;
+    BOOL complete = TRUE;
+    int fd;
+
+    if (!root || !*root || !budget)
+    {
+        fprintf( stderr, "CYDER_IO prewarm skip path=%s offset=%lld "
+                         "reason=%s\n",
+                         target->path, (long long)target->offset,
+                         budget ? "no-game-root" : "budget-exhausted" );
+        return FALSE;
+    }
+    span = target->length;
+    if (span > budget) span = budget;
+    snprintf( path, sizeof(path), "%s/%s", root, target->path );
+    read_offset = target->offset & ~(off_t)(CYDER_MAPLESTORY_FILE_CACHE_MIN_WINDOW - 1);
+    end = target->offset + span;
+    fd = open( path, O_RDONLY );
+    if (fd == -1)
+    {
+        fprintf( stderr, "CYDER_IO prewarm skip path=%s offset=%lld "
+                         "reason=open-failed errno=%d\n",
+                         target->path, (long long)target->offset, errno );
+        return FALSE;
+    }
+
+    if (attempted) (*attempted)++;
+    start = cyder_maplestory_io_timestamp_us();
+    while (read_offset < end)
+    {
+        size_t chunk = sizeof(data);
+        ssize_t result;
+
+        if (end - read_offset < (off_t)chunk) chunk = (size_t)(end - read_offset);
+        result = pread( fd, data, chunk, read_offset );
+        requests++;
+        if (result != (ssize_t)chunk) complete = FALSE;
+        if (result > 0) total_bytes += (unsigned int)result;
+        read_offset += chunk;
+    }
+    duration = cyder_maplestory_io_timestamp_us() - start;
+    close( fd );
+    if (used_bytes) *used_bytes += total_bytes;
+    if (complete && served) (*served)++;
+    fprintf( stderr, "CYDER_IO prewarm item mode=host-path path=%s "
+                     "offset=%lld span=%u requests=%u bytes=%u ret=%s dur_us=%llu\n",
+                     target->path, (long long)target->offset, span, requests,
+                     total_bytes, complete ? "served" : "partial",
+                     duration );
+    return complete;
+}
+
+static void *cyder_maplestory_file_cache_prewarm_thread( void *unused )
+{
+    HANDLE handles[CYDER_MAPLESTORY_FILE_CACHE_SLOTS];
+    char root[PATH_MAX];
+    unsigned int i, j, matched = 0, attempted = 0, served = 0, filled = 0, skipped = 0;
+    unsigned int host_attempted = 0, host_served = 0, used_bytes = 0;
+    unsigned int budget = cyder_maplestory_file_cache_prewarm_max_bytes();
+    BOOL have_root;
+
+    (void)unused;
+    have_root = getcwd( root, sizeof(root) ) != NULL;
+    fprintf( stderr, "CYDER_IO prewarm start targets=%u mode=active-handle-or-host-path "
+                     "budget=%u root=%s\n",
+                     (unsigned int)ARRAY_SIZE(cyder_maplestory_file_cache_prewarm_targets),
+                     budget, have_root ? root : "<none>" );
+    for (i = 0; i < ARRAY_SIZE(cyder_maplestory_file_cache_prewarm_targets); i++)
+    {
+        const struct cyder_maplestory_file_cache_prewarm_target *target =
+            &cyder_maplestory_file_cache_prewarm_targets[i];
+        unsigned int handle_count, span;
+
+        if (used_bytes >= budget) break;
+        span = target->length;
+        if (span > budget - used_bytes) span = budget - used_bytes;
+
+        cyder_maplestory_file_cache_lock_all();
+        handle_count = cyder_maplestory_file_cache_prewarm_snapshot_locked(
+            target->path, handles );
+        cyder_maplestory_file_cache_unlock_all();
+        matched += handle_count;
+        if (!handle_count)
+        {
+            if (!cyder_maplestory_file_cache_prewarm_host_path(
+                    target, have_root ? root : NULL, span, &used_bytes,
+                    &host_attempted, &host_served ))
+                skipped++;
+            continue;
+        }
+
+        fprintf( stderr, "CYDER_IO prewarm target path=%s offset=%lld handles=%u span=%u\n",
+                         target->path, (long long)target->offset, handle_count, span );
+        for (j = 0; j < handle_count; j++)
+        {
+            struct cyder_maplestory_file_cache_entry *entry;
+            unsigned long long fills_before = 0, fills_after = 0;
+            off_t cursor, end;
+            unsigned int target_bytes = 0, target_chunks = 0;
+            int fd, needs_close;
+            char data[CYDER_MAPLESTORY_FILE_CACHE_MAX_REQUEST];
+            BOOL target_served = TRUE;
+
+            if (used_bytes >= budget) break;
+
+            cyder_maplestory_file_cache_lock( handles[j] );
+            entry = cyder_maplestory_file_cache_find( handles[j] );
+            if (entry) fills_before = entry->cache_fills;
+            cyder_maplestory_file_cache_unlock( handles[j] );
+
+            if (server_get_unix_fd( handles[j], FILE_READ_DATA, &fd, &needs_close,
+                                    NULL, NULL ))
+            {
+                skipped++;
+                fprintf( stderr, "CYDER_IO prewarm skip path=%s offset=%lld h=%p "
+                                 "reason=fd-unavailable\n",
+                                 target->path, (long long)target->offset, handles[j] );
+                continue;
+            }
+
+            end = target->offset + span;
+            cursor = target->offset & ~(off_t)(CYDER_MAPLESTORY_FILE_CACHE_MIN_WINDOW - 1);
+            while (cursor < end && used_bytes < budget)
+            {
+                ULONG chunk = CYDER_MAPLESTORY_FILE_CACHE_MAX_REQUEST;
+                ULONG result = 0;
+                BOOL served_now;
+
+                if (end - cursor < (off_t)chunk) chunk = (ULONG)(end - cursor);
+                if (budget - used_bytes < chunk) chunk = budget - used_bytes;
+                served_now = cyder_maplestory_file_cache_read(
+                    handles[j], fd, cursor, data, chunk, &result );
+                attempted++;
+                if (served_now)
+                {
+                    served++;
+                    target_bytes += result;
+                    used_bytes += result;
+                    if (result) target_chunks++;
+                }
+                else
+                    target_served = FALSE;
+                cursor += chunk;
+            }
+            if (needs_close) close( fd );
+
+            cyder_maplestory_file_cache_lock( handles[j] );
+            entry = cyder_maplestory_file_cache_find( handles[j] );
+            if (entry) fills_after = entry->cache_fills;
+            cyder_maplestory_file_cache_unlock( handles[j] );
+
+            if (fills_after > fills_before) filled += (unsigned int)(fills_after - fills_before);
+            if (!target_served) skipped++;
+            fprintf( stderr, "CYDER_IO prewarm item path=%s offset=%lld span=%u h=%p "
+                             "result=%s bytes=%u chunks=%u\n",
+                             target->path, (long long)target->offset, span, handles[j],
+                             target_served ? "served" : "partial", target_bytes, target_chunks );
+            usleep( 1000 );
+        }
+    }
+    fprintf( stderr, "CYDER_IO prewarm done matched=%u attempted=%u served=%u "
+                     "filled=%u host_attempted=%u host_served=%u used_bytes=%u skipped=%u\n",
+                     matched, attempted, served, filled, host_attempted, host_served,
+                     used_bytes, skipped );
+    return NULL;
+}
+
+static void cyder_maplestory_file_cache_prewarm_ensure(void)
+{
+    const char *path;
+    struct stat st;
+    BOOL armed;
+
+    if (!cyder_maplestory_file_cache_prewarm_enabled()) return;
+
+    if (cyder_maplestory_file_cache_prewarm_arm_configured == -1)
+    {
+        path = getenv( "CYDER_MAPLESTORY_IO_RING_ARM_FILE" );
+        if (path && *path)
+        {
+            cyder_maplestory_file_cache_prewarm_arm_configured = 1;
+            snprintf( cyder_maplestory_file_cache_prewarm_arm_path,
+                      sizeof(cyder_maplestory_file_cache_prewarm_arm_path), "%s", path );
+            /* Start unarmed so a pre-existing arm file still produces a
+             * transition after map load. */
+            cyder_maplestory_file_cache_prewarm_armed = FALSE;
+        }
+        else
+        {
+            cyder_maplestory_file_cache_prewarm_arm_configured = 0;
+            TRACE_(cyderio)( "CYDER_IO prewarm waiting reason=no-arm-file\n" );
+        }
+    }
+
+    if (!cyder_maplestory_file_cache_prewarm_arm_configured) return;
+    if (cyder_maplestory_file_cache_prewarm_started) return;
+    if (cyder_maplestory_file_cache_prewarm_armed) return;
+
+    armed = !stat( cyder_maplestory_file_cache_prewarm_arm_path, &st );
+    if (!armed) return;
+
+    TRACE_(cyderio)( "CYDER_IO prewarm arm t=%llu path=%s\n",
+                     cyder_maplestory_io_timestamp_us(),
+                     cyder_maplestory_file_cache_prewarm_arm_path );
+    cyder_maplestory_file_cache_prewarm_armed = TRUE;
+    cyder_maplestory_file_cache_prewarm_request();
+}
+
+static void cyder_maplestory_file_cache_prewarm_request(void)
+{
+    if (cyder_maplestory_file_cache_prewarm_enabled() &&
+        cyder_maplestory_file_cache_prewarm_armed)
+        cyder_maplestory_file_cache_prewarm_requested = TRUE;
+}
+
+static void cyder_maplestory_file_cache_prewarm_start(void)
+{
+    pthread_t thread;
+
+    cyder_maplestory_file_cache_lock_all();
+    if (cyder_maplestory_file_cache_prewarm_started ||
+        !cyder_maplestory_file_cache_prewarm_requested ||
+        !cyder_maplestory_file_cache_prewarm_enabled() ||
+        !cyder_maplestory_file_cache_prewarm_armed)
+    {
+        cyder_maplestory_file_cache_unlock_all();
+        return;
+    }
+    cyder_maplestory_file_cache_prewarm_started = TRUE;
+    cyder_maplestory_file_cache_prewarm_requested = FALSE;
+    cyder_maplestory_file_cache_unlock_all();
+
+    if (pthread_create( &thread, NULL, cyder_maplestory_file_cache_prewarm_thread, NULL ))
+    {
+        TRACE_(cyderio)( "CYDER_IO prewarm skipped reason=thread-create-failed\n" );
+        cyder_maplestory_file_cache_lock_all();
+        cyder_maplestory_file_cache_prewarm_started = FALSE;
+        cyder_maplestory_file_cache_unlock_all();
+        return;
+    }
+    pthread_detach( thread );
+}
