+static BOOL is_maplestory_process(void)
+{
+    static const WCHAR maplestoryW[] = {'M','a','p','l','e','S','t','o','r','y','.','e','x','e',0};
+    const WCHAR *name;
+
+    if (!main_wargv || !main_wargv[0]) return FALSE;
+    name = ntdll_wcsrchr( main_wargv[0], '\\' );
+    if (name) name++;
+    else name = main_wargv[0];
+    return !ntdll_wcsicmp( name, maplestoryW );
+}
