+static void cyder_maplestory_io_summary_reset_locked(void)
+{
+    memset( cyder_maplestory_io_summaries, 0, sizeof(cyder_maplestory_io_summaries) );
+    cyder_maplestory_io_summary_dropped = 0;
+    cyder_maplestory_io_summary_dumped = FALSE;
+}
+
+static struct cyder_maplestory_io_summary *cyder_maplestory_io_summary_find_locked(
+    const char *path )
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(cyder_maplestory_io_summaries); i++)
+        if (cyder_maplestory_io_summaries[i].used &&
+            !strcmp( cyder_maplestory_io_summaries[i].path, path ))
+            return &cyder_maplestory_io_summaries[i];
+    return NULL;
+}
+
+static struct cyder_maplestory_io_summary *cyder_maplestory_io_summary_slot_locked(void)
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(cyder_maplestory_io_summaries); i++)
+        if (!cyder_maplestory_io_summaries[i].used)
+            return &cyder_maplestory_io_summaries[i];
+    return NULL;
+}
+
+static void cyder_maplestory_io_summary_record_locked(
+    unsigned int kind, int fd, off_t offset, ULONG length, long long result,
+    unsigned long long timestamp, unsigned long long duration,
+    const struct cyder_maplestory_file_cache_entry *entry )
+{
+    struct cyder_maplestory_io_summary *summary;
+    char host_path[PATH_MAX];
+    const char *path = "?";
+
+    if (entry && entry->path[0])
+        path = entry->path;
+#ifdef F_GETPATH
+    else if (fd >= 0 && !fcntl( fd, F_GETPATH, host_path ))
+        path = host_path;
+#endif
+
+    summary = cyder_maplestory_io_summary_find_locked( path );
+    if (!summary)
+    {
+        summary = cyder_maplestory_io_summary_slot_locked();
+        if (!summary)
+        {
+            cyder_maplestory_io_summary_dropped++;
+            return;
+        }
+        memset( summary, 0, sizeof(*summary) );
+        summary->used = TRUE;
+        snprintf( summary->path, sizeof(summary->path), "%s", path );
+    }
+
+    summary->events++;
+    if (!summary->first_timestamp) summary->first_timestamp = timestamp;
+    summary->last_timestamp = timestamp;
+
+    if (kind == CYDER_MAPLESTORY_IO_RING_NTREAD)
+    {
+        long long delta;
+
+        summary->ntread_calls++;
+        summary->ntread_bytes += length;
+        if (length <= 1) summary->len_le1++;
+        else if (length <= 4096) summary->len_le4k++;
+        else summary->len_gt4k++;
+
+        if (summary->ntread_calls == 1)
+        {
+            summary->first_length = length;
+            summary->min_length = length;
+            summary->max_length = length;
+        }
+        else
+        {
+            if (length < summary->min_length) summary->min_length = length;
+            if (length > summary->max_length) summary->max_length = length;
+        }
+        summary->last_length = length;
+
+        if (offset < 0)
+            summary->offset_unknown++;
+        else
+        {
+            summary->offset_samples++;
+            if (!summary->have_offset_range)
+            {
+                summary->first_offset = offset;
+                summary->min_offset = offset;
+                summary->max_offset = offset;
+                summary->have_offset_range = TRUE;
+            }
+            else
+            {
+                if (offset < summary->min_offset) summary->min_offset = offset;
+                if (offset > summary->max_offset) summary->max_offset = offset;
+            }
+
+            if (summary->have_last_offset)
+            {
+                delta = offset - summary->profile_last_offset;
+                if (offset == summary->profile_last_offset + (off_t)summary->profile_last_length)
+                    summary->sequential_reads++;
+                if (delta > 0) summary->forward_reads++;
+                else if (delta < 0) summary->backward_reads++;
+                if (delta >= -8192 && delta <= 8192)
+                    summary->nearby_reads++;
+            }
+            summary->profile_last_offset = offset;
+            summary->profile_last_length = length;
+            summary->have_last_offset = TRUE;
+            summary->last_offset = offset;
+        }
+    }
+    else
+    {
+        summary->host_read_calls++;
+        if (result > 0) summary->host_read_bytes += result;
+        if (result < 0) summary->host_read_failures++;
+        summary->host_read_dur_us += duration;
+    }
+}
+
+static void cyder_maplestory_io_summary_dump_locked(void)
+{
+    unsigned int i, count = 0;
+
+    if (cyder_maplestory_io_summary_dumped) return;
+    cyder_maplestory_io_summary_dumped = TRUE;
+    for (i = 0; i < ARRAY_SIZE(cyder_maplestory_io_summaries); i++)
+        if (cyder_maplestory_io_summaries[i].used) count++;
+
+    TRACE_(cyderio)( "CYDER_IO aggregate count=%u dropped=%llu capacity=%u\n",
+                     count, cyder_maplestory_io_summary_dropped,
+                     CYDER_MAPLESTORY_IO_SUMMARY_SLOTS );
+    for (i = 0; i < ARRAY_SIZE(cyder_maplestory_io_summaries); i++)
+    {
+        const struct cyder_maplestory_io_summary *summary = &cyder_maplestory_io_summaries[i];
+
+        if (!summary->used) continue;
+        TRACE_(cyderio)( "CYDER_IO aggregate path=%s events=%llu ntread=%llu ntbytes=%llu "
+                         "host=%llu hostbytes=%llu hostdur_us=%llu failures=%llu "
+                         "le1=%llu le4k=%llu gt4k=%llu offs=%llu unknown=%llu "
+                         "seq=%llu nearby=%llu forward=%llu backward=%llu "
+                         "first_t=%llu last_t=%llu first_off=%lld last_off=%lld "
+                         "min_off=%lld max_off=%lld first_len=%u last_len=%u "
+                         "min_len=%u max_len=%u\n",
+                         summary->path, summary->events, summary->ntread_calls,
+                         summary->ntread_bytes, summary->host_read_calls,
+                         summary->host_read_bytes, summary->host_read_dur_us,
+                         summary->host_read_failures, summary->len_le1,
+                         summary->len_le4k, summary->len_gt4k, summary->offset_samples,
+                         summary->offset_unknown, summary->sequential_reads,
+                         summary->nearby_reads, summary->forward_reads,
+                         summary->backward_reads, summary->first_timestamp,
+                         summary->last_timestamp, (long long)summary->first_offset,
+                         (long long)summary->last_offset, (long long)summary->min_offset,
+                         (long long)summary->max_offset, summary->first_length,
+                         summary->last_length, summary->min_length, summary->max_length );
+    }
 }
 
