+
+#define CYDER_MAPLESTORY_READAHEAD_MAX_GAP   (1024 * 1024)
+#define CYDER_MAPLESTORY_READAHEAD_CHUNK     (2 * 1024 * 1024)
+#define CYDER_MAPLESTORY_READAHEAD_MIN_FILLS 2
 
+static BOOL cyder_maplestory_readahead_enabled(void)
+{
+    static int enabled = -1;
+    const char *value;
+
+    if (enabled == -1)
+    {
+        value = getenv( "CYDER_MAPLESTORY_READAHEAD" );
+        enabled = value && (!strcmp( value, "1" ) || !strcmp( value, "true" ));
+    }
+    return enabled == 1;
+}
+
+/* Called with the cache mutex held, before a window fill.  MapleStory scans
+ * large WZ files forward with gaps (e.g. 8-208 KiB between 8 KiB reads on the
+ * first hit).  macOS only reads ahead for contiguous reads, so each fill
+ * waits for the SSD on its own; the NT cache manager instead detects forward
+ * (and strided) progress and reads ahead asynchronously.  Mirror that: once
+ * fills keep moving forward with gaps up to MAX_GAP, ask the kernel to read
+ * the next CHUNK past a moving frontier (F_RDADVISE is asynchronous). */
+static void cyder_maplestory_file_cache_readahead( struct cyder_maplestory_file_cache_entry *entry,
+                                                   int fd, off_t window_offset, size_t window_size )
+{
+    struct radvisory advice;
+    off_t start;
+
+    if (!cyder_maplestory_readahead_enabled()) return;
+
+    if (entry->readahead_have_last_fill && window_offset > entry->readahead_last_fill &&
+        window_offset - entry->readahead_last_fill <= CYDER_MAPLESTORY_READAHEAD_MAX_GAP)
+    {
+        if (entry->readahead_forward_fills < CYDER_MAPLESTORY_READAHEAD_MIN_FILLS)
+            entry->readahead_forward_fills++;
+    }
+    else
+    {
+        entry->readahead_forward_fills = 0;
+        entry->readahead_frontier = 0;
+    }
+    entry->readahead_last_fill = window_offset;
+    entry->readahead_have_last_fill = TRUE;
+
+    if (entry->readahead_forward_fills < CYDER_MAPLESTORY_READAHEAD_MIN_FILLS) return;
+    if (window_offset + CYDER_MAPLESTORY_READAHEAD_CHUNK / 2 < entry->readahead_frontier) return;
+
+    start = window_offset + (off_t)window_size;
+    if (entry->readahead_frontier > start) start = entry->readahead_frontier;
+    advice.ra_offset = start;
+    advice.ra_count = CYDER_MAPLESTORY_READAHEAD_CHUNK;
+    /* Errors (e.g. past EOF) are harmless: this is only a hint. */
+    fcntl( fd, F_RDADVISE, &advice );
+    entry->readahead_frontier = start + CYDER_MAPLESTORY_READAHEAD_CHUNK;
+    entry->readahead_advises++;
+}
