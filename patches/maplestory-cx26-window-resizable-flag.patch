+/* MapleStoryPort: keep the main window's backend state non-resizable too. */
+static BOOL is_maplestory_main_window(HWND hwnd)
+{
+    static const WCHAR maplestory_classW[] =
+        {'M','a','p','l','e','S','t','o','r','y','C','l','a','s','s',0};
+    static const WCHAR maplestory_titleW[] =
+        {'M','a','p','l','e','S','t','o','r','y',0};
+    WCHAR class[32], title[32];
+    UNICODE_STRING name = { .Buffer = class, .MaximumLength = sizeof(class) };
+
+    if (NtUserGetClassName(hwnd, FALSE, &name) && !wcscmp(class, maplestory_classW))
+        return TRUE;
+
+    return NtUserInternalGetWindowText(hwnd, title, sizeof(title) / sizeof(title[0])) &&
+           !wcscmp(title, maplestory_titleW);
+}
