+	const auto start = chrono::steady_clock::now();
+	const bool timed = (timeout != UINT64_MAX);
+	const chrono::nanoseconds budget(timed ? min(timeout, kMVKUndefinedLargeUInt64) : 0);
+
+	// ~100us balances wake latency vs CPU; matches DXVK's high-frequency waits.
+	static constexpr chrono::microseconds kPollSlice(100);
+
+	for (;;) {
+		if (device->getConfigurationResult() != VK_SUCCESS) {
+			return device->getConfigurationResult();
+		}
+		if (isComplete()) { return VK_SUCCESS; }
+
+		if (timed) {
+			auto elapsed = chrono::steady_clock::now() - start;
+			if (elapsed >= budget) { return VK_TIMEOUT; }
+			auto remaining = budget - elapsed;
+			this_thread::sleep_for(remaining < kPollSlice ? remaining : kPollSlice);
+		} else {
+			this_thread::sleep_for(kPollSlice);
+		}
+	}
