-// Create a blocking fence sitter, add it to each semaphore, wait, then remove it.
+// Poll timeline counter values instead of registering MTLSharedEvent
+// notifyListener callbacks via MVKFenceSitter.
+//
+// Cyder: each -[MTLSharedEvent notifyListener:atValue:block:] retains a Mach
+// receive right until the event reaches the waited value. DXVK issues many
+// finite-timeout vkWaitSemaphores that expire first, so those rights
+// accumulate (~80+/s Ports growth under MapleStory Classic + DXVK). Upstream
+// #1860 only released the MTLSharedEventListener object; it does not cancel
+// pending notifyListener registrations. Polling getCounterValue() avoids the
+// Metal listener path entirely for host waits.
 VkResult mvkWaitSemaphores(MVKDevice* device,
 						   const VkSemaphoreWaitInfo* pWaitInfo,
 						   uint64_t timeout) {
@@ -532,31 +543,52 @@
 		return device->getConfigurationResult();
 	}
 
-	VkResult rslt = VK_SUCCESS;
 	bool waitAny = mvkIsAnyFlagEnabled(pWaitInfo->flags, VK_SEMAPHORE_WAIT_ANY_BIT);
-	bool alreadySignaled = false;
-	MVKFenceSitter fenceSitter(!waitAny);
 
-	for (uint32_t i = 0; i < pWaitInfo->semaphoreCount; i++) {
-		if (((MVKTimelineSemaphore*)pWaitInfo->pSemaphores[i])->registerWait(&fenceSitter, pWaitInfo, i) && waitAny) {
-			// In this case, we don't need to wait.
-			alreadySignaled = true;
-			break;
-		}
-	}
+	auto isReached = [&](uint32_t index) -> bool {
+		auto* sem = (MVKTimelineSemaphore*)pWaitInfo->pSemaphores[index];
+		return sem->getCounterValue() >= pWaitInfo->pValues[index];
+	};
 
-	bool finished = alreadySignaled || fenceSitter.wait(timeout);
-	if (device->getConfigurationResult() != VK_SUCCESS) {
-		rslt = device->getConfigurationResult();
-	} else if ( !finished ) {
-		rslt = VK_TIMEOUT;
-	}
+	auto isComplete = [&]() -> bool {
+		if (pWaitInfo->semaphoreCount == 0) { return true; }
+		if (waitAny) {
+			for (uint32_t i = 0; i < pWaitInfo->semaphoreCount; i++) {
+				if (isReached(i)) { return true; }
+			}
+			return false;
+		}
+		for (uint32_t i = 0; i < pWaitInfo->semaphoreCount; i++) {
+			if ( !isReached(i) ) { return false; }
+		}
+		return true;
+	};
 
-	for (uint32_t i = 0; i < pWaitInfo->semaphoreCount; i++) {
-		((MVKTimelineSemaphore*)pWaitInfo->pSemaphores[i])->unregisterWait(&fenceSitter);
-	}
+	if (isComplete()) { return VK_SUCCESS; }
