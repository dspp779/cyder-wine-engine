+/* Query volume size through a directory fd so ntdll can fstatvfs the host mount.
+ * Device paths like \\.\C: fail FILE_DIRECTORY_FILE; map those to C:\. */
+static BOOL query_disk_free_space( LPCWSTR root, PULARGE_INTEGER avail,
+                                   PULARGE_INTEGER total, PULARGE_INTEGER totalfree )
 {
     FILE_FS_SIZE_INFORMATION info;
     IO_STATUS_BLOCK io;
@@ -654,8 +653,6 @@
     HANDLE handle;
     UINT units;
 
-    TRACE( "%s,%p,%p,%p\n", debugstr_w(root), avail, total, totalfree );
-
     if (!open_device_root( root, &handle )) return FALSE;
 
     status = NtQueryVolumeInformationFile( handle, &io, &info, sizeof(info), FileFsSizeInformation );
@@ -670,8 +667,54 @@
     return TRUE;
 }
 
+static BOOL dos_drive_root_from_device_path( LPCWSTR root, WCHAR drive_root[4] )
+{
+    if (!root || root[0] != '\\' || root[1] != '\\') return FALSE;
+    if ((root[2] != '.' && root[2] != '?') || root[3] != '\\') return FALSE;
+    if (!((root[4] >= 'A' && root[4] <= 'Z') || (root[4] >= 'a' && root[4] <= 'z'))) return FALSE;
+    if (root[5] != ':') return FALSE;
+    if (root[6] && (root[6] != '\\' || root[7])) return FALSE;
+    drive_root[0] = root[4];
+    drive_root[1] = ':';
+    drive_root[2] = '\\';
+    drive_root[3] = 0;
+    return TRUE;
+}
 
 /***********************************************************************
+ *           GetDiskFreeSpaceExW   (kernelbase.@)
+ */
+BOOL WINAPI DECLSPEC_HOTPATCH GetDiskFreeSpaceExW( LPCWSTR root, PULARGE_INTEGER avail,
+                                                   PULARGE_INTEGER total, PULARGE_INTEGER totalfree )
+{
+    WCHAR drive_root[4];
+
+    TRACE( "%s,%p,%p,%p\n", debugstr_w(root), avail, total, totalfree );
+
+    if (query_disk_free_space( root, avail, total, totalfree )) return TRUE;
+
+    /* Cyder: retry a real mapped volume instead of inventing free space. */
+    if (dos_drive_root_from_device_path( root, drive_root ) &&
+        query_disk_free_space( drive_root, avail, total, totalfree ))
+    {
+        WARN( "failed to open device root %s, using %s\n", debugstr_w(root), debugstr_w(drive_root) );
+        return TRUE;
+    }
+    if (root && query_disk_free_space( NULL, avail, total, totalfree ))
+    {
+        WARN( "failed to open device root %s, using current volume\n", debugstr_w(root) );
+        return TRUE;
+    }
+    if (windows_dir[0] && query_disk_free_space( windows_dir, avail, total, totalfree ))
+    {
+        WARN( "failed to open device root %s, using windows dir volume\n", debugstr_w(root) );
+        return TRUE;
+    }
+    return FALSE;
+}
+
