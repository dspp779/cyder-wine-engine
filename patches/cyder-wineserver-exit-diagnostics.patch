 static struct timeout_user *shutdown_timeout;  /* timeout for server shutdown */
 static int shutdown_stage;  /* current stage in the shutdown process */
 
+/* Cyder: leave an explicit breadcrumb when wineserver is about to exit so a
+ * silent SIGTERM / main_loop return can be distinguished from a crash. */
+void wineserver_log_exit_state(void)
+{
+    fprintf( stderr, "wineserver: exit state running_processes=%d user_processes=%d"
+             " shutdown_stage=%d\n",
+             running_processes, user_processes, shutdown_stage );
+    fflush( stderr );
+}
