 static struct timeout_user *shutdown_timeout;  /* timeout for server shutdown */
 static int shutdown_stage;  /* current stage in the shutdown process */
 
+/* Cyder: dual-write diagnostics to stderr and $WINEPREFIX/cyder-wineserver-diag.log
+ * so a killed gzip capture pipe cannot erase the only copy of the death reason. */
+void wineserver_diag_printf( const char *fmt, ... )
+{
+    va_list ap, ap2;
+    int fd = -1;
+
+    va_start( ap, fmt );
+    va_copy( ap2, ap );
+    vfprintf( stderr, fmt, ap );
+    fflush( stderr );
+    va_end( ap );
+
+    if (config_dir_fd != -1)
+        fd = openat( config_dir_fd, "cyder-wineserver-diag.log",
+                     O_WRONLY | O_CREAT | O_APPEND, 0600 );
+    if (fd == -1)
+    {
+        const char *prefix = getenv( "WINEPREFIX" );
+        char path[PATH_MAX];
+        if (prefix && snprintf( path, sizeof(path), "%s/cyder-wineserver-diag.log",
+                                prefix ) < (int)sizeof(path))
+            fd = open( path, O_WRONLY | O_CREAT | O_APPEND, 0600 );
+    }
+    if (fd != -1)
+    {
+        vdprintf( fd, fmt, ap2 );
+        fsync( fd );
+        close( fd );
+    }
+    va_end( ap2 );
+}
+
+void wineserver_log_exit_state(void)
+{
+    wineserver_diag_printf( "wineserver: exit state running_processes=%d user_processes=%d"
+                            " shutdown_stage=%d\n",
+                            running_processes, user_processes, shutdown_stage );
+}
