+
+/* Cyder QDO context ring: memory-only + periodic file snapshot.
+ * DO NOT use SIGUSR1 — Wine uses it for thread suspend.
+ * Opt-in: CYDER_QDO_RING=1
+ * Snapshot every 512 records (and final overwrite) to CYDER_QDO_RING_PATH.
+ * Marker: "cyder QDO RING"
+ */
+enum { CYDER_QDO_RING_SIZE = 4096 };
+enum { CYDER_QDO_RING_FLUSH_EVERY = 512 };
+
+struct cyder_qdo_rec
+{
+    ULONG seq;
+    ULONG handle_lo;
+    ULONG single;
+    ULONG restart;
+    ULONG ctx_in;
+    ULONG index;
+    ULONG status;
+    ULONG ctx_out;
+    ULONG used;
+    ULONG size;
+    ULONG phase; /* 1=enter, 2=leave, 3=early */
+};
+
+static struct cyder_qdo_rec cyder_qdo_ring[CYDER_QDO_RING_SIZE];
+static volatile int cyder_qdo_ring_seq;
+static volatile int cyder_qdo_ring_on = -1;
+
+static int cyder_qdo_ring_enabled(void)
+{
+    if (cyder_qdo_ring_on < 0)
+        cyder_qdo_ring_on = getenv( "CYDER_QDO_RING" ) != NULL;
+    return cyder_qdo_ring_on;
+}
+
+static void cyder_qdo_ring_flush(void)
+{
+    const char *path;
+    int fd;
+    int seq, start, i, count;
+    char line[256];
+
+    path = getenv( "CYDER_QDO_RING_PATH" );
+    if (!path || !path[0])
+        path = "/tmp/cyder-qdo-ring.txt";
+    fd = open( path, O_WRONLY | O_CREAT | O_TRUNC, 0644 );
+    if (fd < 0) return;
+
+    seq = cyder_qdo_ring_seq;
+    count = seq < CYDER_QDO_RING_SIZE ? seq : CYDER_QDO_RING_SIZE;
+    start = seq < CYDER_QDO_RING_SIZE ? 0 : (seq - CYDER_QDO_RING_SIZE);
+    {
+        int n = snprintf( line, sizeof(line),
+                          "cyder QDO RING dump seq=%ld count=%ld\n",
+                          (long)seq, (long)count );
+        if (n > 0) write( fd, line, (size_t)n );
+    }
+    for (i = 0; i < count; i++)
+    {
+        const struct cyder_qdo_rec *r = &cyder_qdo_ring[(start + i) % CYDER_QDO_RING_SIZE];
+        int n = snprintf( line, sizeof(line),
+                          "cyder QDO RING p=%u seq=%u h=0x%x single=%u restart=%u ctx_in=%u index=%u status=%08x ctx_out=%u used=%u size=%u\n",
+                          r->phase, r->seq, r->handle_lo, r->single, r->restart,
+                          r->ctx_in, r->index, r->status, r->ctx_out, r->used, r->size );
+        if (n > 0) write( fd, line, (size_t)n );
+    }
+    close( fd );
+}
+
+static void cyder_qdo_ring_push( const struct cyder_qdo_rec *rec )
+{
+    int n = __sync_add_and_fetch( &cyder_qdo_ring_seq, 1 );
+    cyder_qdo_ring[(n - 1) % CYDER_QDO_RING_SIZE] = *rec;
+    if ((n % CYDER_QDO_RING_FLUSH_EVERY) == 0)
+        cyder_qdo_ring_flush();
+}
+
