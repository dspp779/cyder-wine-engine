--- a/dlls/ntdll/unix/sync.c.vanilla-qdo-bisect	2026-08-07 22:32:46
+++ b/dlls/ntdll/unix/sync.c	2026-08-07 22:33:28
@@ -2073,6 +2073,24 @@
 }
 
 
+/* Bisect v4: QDO fprintf paths without ULONG need rewrite.
+ * Opt-in: CYDER_QDO_TRACE=1. Logs the first 64 calls, then every 10000th.
+ * Marker string: "cyder QDO"
+ */
+static int cyder_qdo_should_trace( LONG *seq_out )
+{
+    static int enabled = -1;
+    static LONG seq;
+    LONG n;
+
+    if (enabled < 0)
+        enabled = getenv( "CYDER_QDO_TRACE" ) != NULL;
+    if (!enabled) return 0;
+    n = ++seq;
+    if (seq_out) *seq_out = n;
+    return n <= 64 || (n % 10000) == 0;
+}
+
 /**************************************************************************
  *           NtQueryDirectoryObject   (NTDLL.@)
  */
@@ -2081,8 +2099,17 @@
                                         ULONG *context, ULONG *ret_size )
 {
     unsigned int status, i, count, total_len, pos, used_size, used_count, strpool_head;
+    ULONG ctx_in = context ? *context : ~0u;
     ULONG index = restart ? 0 : *context;
     struct directory_entry *entries;
+    LONG diag_n = 0;
+    int diag = cyder_qdo_should_trace( &diag_n );
+
+    if (diag)
+        fprintf( stderr,
+                 "cyder QDO enter h=%p single=%u restart=%u ctx_in=%lu size=%lu n=%ld\n",
+                 handle, single_entry, restart, (unsigned long)ctx_in, (unsigned long)size,
+                 (long)diag_n );
 
     if (!(entries = malloc( size ))) return STATUS_NO_MEMORY;
 
@@ -2101,6 +2128,10 @@
     if (status && status != STATUS_MORE_ENTRIES)
     {
         free( entries );
+        if (diag)
+            fprintf( stderr,
+                     "cyder QDO leave early ret=%08x ctx_out=%lu n=%ld\n",
+                     status, (unsigned long)(context ? *context : ~0u), (long)diag_n );
         return status;
     }
 
@@ -2156,17 +2187,32 @@
     if (!count && !status)
     {
         if (ret_size) *ret_size = sizeof(*buffer);
+        if (diag)
+            fprintf( stderr,
+                     "cyder QDO leave ret=%08x ctx_out=%lu used=0 ret_size=%lu n=%ld\n",
+                     STATUS_NO_MORE_ENTRIES, (unsigned long)(context ? *context : ~0u),
+                     (unsigned long)sizeof(*buffer), (long)diag_n );
         return STATUS_NO_MORE_ENTRIES;
     }
 
     if (single_entry && !used_count)
     {
         if (ret_size) *ret_size = 2 * sizeof(*buffer) + 2 * sizeof(WCHAR) + total_len;
+        if (diag)
+            fprintf( stderr,
+                     "cyder QDO leave ret=%08x ctx_out=%lu used=0 ret_size=%lu n=%ld\n",
+                     STATUS_BUFFER_TOO_SMALL, (unsigned long)(context ? *context : ~0u),
+                     (unsigned long)(2 * sizeof(*buffer) + 2 * sizeof(WCHAR) + total_len), (long)diag_n );
         return STATUS_BUFFER_TOO_SMALL;
     }
 
     *context = index + used_count;
     if (ret_size) *ret_size = strpool_head;
+    if (diag)
+        fprintf( stderr,
+                 "cyder QDO leave ret=%08x ctx_out=%lu used=%u ret_size=%lu n=%ld\n",
+                 status, (unsigned long)*context, used_count,
+                 (unsigned long)(ret_size ? *ret_size : 0), (long)diag_n );
     return status;
 }
 
