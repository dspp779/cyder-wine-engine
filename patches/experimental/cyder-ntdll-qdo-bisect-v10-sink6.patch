+/* Bisect v10: same 6-arg call site as v9, but noinline sink (not fprintf). */
+static int cyder_qdo_should_trace( LONG *seq_out )
+{
+    static int enabled = -1;
+    static LONG seq;
+    LONG n;
+
+    if (enabled < 0)
+        enabled = getenv( "CYDER_QDO_TRACE" ) != NULL;
+    if (!enabled) return 0;
+    n = ++seq;
+    if (seq_out) *seq_out = n;
+    return n <= 64 || (n % 10000) == 0;
 }
 
+__attribute__((noinline)) static void cyder_qdo_sink6( void *a, unsigned b, unsigned c,
+                                                       unsigned long d, unsigned long e, long f )
+{
+    (void)a; (void)b; (void)c; (void)d; (void)e; (void)f;
+}
 
