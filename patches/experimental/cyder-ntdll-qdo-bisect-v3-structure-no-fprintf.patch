+/* Bisect v3: full QDO structure without fprintf. Marker: CYDER_QDO_TRACE */
+static int cyder_qdo_should_trace( LONG *seq_out )
+{
+    static int enabled = -1;
+    static LONG seq;
+    LONG n;
+
+    if (enabled < 0)
+        enabled = getenv( "CYDER_QDO_TRACE" ) != NULL;
+    if (!enabled) return 0;
+    n = ++seq;
+    if (seq_out) *seq_out = n;
+    return n <= 64 || (n % 10000) == 0;
+}
