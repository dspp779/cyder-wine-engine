 }
 
 
+
+/* Cyder QDO context ring v2: MEMORY ONLY (no file I/O, no signals).
+ * Flush-on-write bandaged residual; this build should residual like v5.
+ * Opt-in: CYDER_QDO_RING=1
+ * Dump: external reader via lldb/vmmap OR pair with GDE (server index).
+ * Marker: "cyder QDO RING"
+ */
+enum { CYDER_QDO_RING_SIZE = 4096 };
+
+struct cyder_qdo_rec
+{
+    ULONG seq;
+    ULONG handle_lo;
+    ULONG single;
+    ULONG restart;
+    ULONG ctx_in;
+    ULONG index;
+    ULONG status;
+    ULONG ctx_out;
+    ULONG used;
+    ULONG size;
+    ULONG phase; /* 1=enter, 2=leave, 3=early */
+};
+
+static struct cyder_qdo_rec cyder_qdo_ring[CYDER_QDO_RING_SIZE];
+static volatile int cyder_qdo_ring_seq;
+static volatile int cyder_qdo_ring_on = -1;
+
+/* Exported-ish symbols for lldb: keep names unique and used */
+__attribute__((used)) static const char cyder_qdo_ring_magic[] = "cyder QDO RING magic";
+
+static int cyder_qdo_ring_enabled(void)
+{
+    if (cyder_qdo_ring_on < 0)
+        cyder_qdo_ring_on = getenv( "CYDER_QDO_RING" ) != NULL;
+    return cyder_qdo_ring_on;
+}
+
+__attribute__((noinline)) static void cyder_qdo_ring_push( const struct cyder_qdo_rec *rec )
+{
+    int n = __sync_add_and_fetch( &cyder_qdo_ring_seq, 1 );
+    cyder_qdo_ring[(n - 1) % CYDER_QDO_RING_SIZE] = *rec;
+}
+
