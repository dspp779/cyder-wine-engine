+        rec.ctx_in = ctx_in;
+        rec.index = index;
+        rec.size = size;
+        rec.phase = 1;
+        cyder_qdo_ring_push( &rec );
+    }
 
     if (!(entries = malloc( size ))) return STATUS_NO_MEMORY;
 
