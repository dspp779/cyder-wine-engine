+/* Opt-in residual capture: CYDER_GDE_TRACE=1. Logs first 64 then every 10000th.
+ * Marker: cyder GDE
+ */
+static int cyder_gde_should_trace( void )
+{
+    static int enabled = -1;
+    static unsigned long seq;
+    unsigned long n;
+
+    if (enabled < 0)
+        enabled = getenv( "CYDER_GDE_TRACE" ) != NULL;
+    if (!enabled) return 0;
+    n = ++seq;
+    return n <= 64 || (n % 10000) == 0;
+}
+
+static void cyder_gde_log_name( const WCHAR *name, data_size_t len )
+{
+    data_size_t i, n = len / sizeof(WCHAR);
+    char buf[128];
+    size_t o = 0;
+
+    for (i = 0; i < n && o + 1 < sizeof(buf); i++)
+    {
+        WCHAR c = name[i];
+        buf[o++] = (c >= 0x20 && c < 0x7f) ? (char)c : '?';
+    }
+    buf[o] = 0;
+    wineserver_diag_printf( "%s", buf );
+}
