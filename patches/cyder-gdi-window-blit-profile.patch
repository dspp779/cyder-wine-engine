--- /dev/null
+++ b/dlls/gdi32/cyder_gdi_profile.h
@@ -0,0 +1,115 @@
+/* Opt-in GDI window blit submissions; never display/GPU completion. */
+#ifndef CYDER_GDI_PROFILE_H
+#define CYDER_GDI_PROFILE_H
+#include <stdio.h>
+#include <stdint.h>
+static INIT_ONCE cyder_gdi_profile_once = INIT_ONCE_STATIC_INIT;
+static SRWLOCK cyder_gdi_profile_lock = SRWLOCK_INIT;
+static HANDLE cyder_gdi_profile_file = INVALID_HANDLE_VALUE;
+static char cyder_gdi_profile_buffer[32768];
+static DWORD cyder_gdi_profile_used;
+
+static BOOL cyder_gdi_profile_write(const char *data, DWORD size)
+{
+    DWORD done;
+    if (cyder_gdi_profile_file == INVALID_HANDLE_VALUE) return FALSE;
+    if (WriteFile(cyder_gdi_profile_file, data, size, &done, NULL) && done == size) return TRUE;
+    ERR("CYDER_GDI_PROFILE write failed; capture incomplete.\n");
+    CloseHandle(cyder_gdi_profile_file);
+    cyder_gdi_profile_file = INVALID_HANDLE_VALUE;
+    cyder_gdi_profile_used = 0;
+    return FALSE;
+}
+
+static BOOL CALLBACK cyder_gdi_profile_init(INIT_ONCE *once, void *parameter, void **context)
+{
+    char dir[MAX_PATH], path[MAX_PATH], header[512];
+    LARGE_INTEGER before, after, frequency;
+    ULARGE_INTEGER wall;
+    FILETIME ft;
+    DWORD length;
+    int size;
+    (void)once; (void)parameter; (void)context;
+    length = GetEnvironmentVariableA("CYDER_GDI_PROFILE_DIR", dir, sizeof(dir));
+    if (!length || length >= sizeof(dir) - 48) return TRUE;
+    snprintf(path, sizeof(path), "%s\\gdi-present-%08lx.csv", dir, GetCurrentProcessId());
+    cyder_gdi_profile_file = CreateFileA(path, GENERIC_WRITE, FILE_SHARE_READ, NULL,
+            CREATE_NEW, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (cyder_gdi_profile_file == INVALID_HANDLE_VALUE)
+    {
+        ERR("CYDER_GDI_PROFILE cannot exclusively create capture.\n");
+        return TRUE;
+    }
+    QueryPerformanceFrequency(&frequency);
+    QueryPerformanceCounter(&before);
+    GetSystemTimePreciseAsFileTime(&ft);
+    QueryPerformanceCounter(&after);
+    wall.LowPart = ft.dwLowDateTime; wall.HighPart = ft.dwHighDateTime;
+    size = snprintf(header, sizeof(header),
+            "# CYDER_GDI_PROFILE frequency=%llu anchor_qpc=%llu anchor_epoch_ns=%llu windows_pid=%lu\n"
+            "begin_qpc,end_qpc,thread_id,surface,left,top,width,height,primary_width,primary_height,hresult,api,src_width,src_height,stretch_mode,rop\n",
+            (unsigned long long)frequency.QuadPart,
+            (unsigned long long)(before.QuadPart + (after.QuadPart - before.QuadPart) / 2),
+            (unsigned long long)((wall.QuadPart - 116444736000000000ULL) * 100), GetCurrentProcessId());
+    if (size <= 0 || (size_t)size >= sizeof(header))
+    {
+        CloseHandle(cyder_gdi_profile_file);
+        cyder_gdi_profile_file = INVALID_HANDLE_VALUE;
+        return TRUE;
+    }
+    cyder_gdi_profile_write(header, size);
+    return TRUE;
+}
+
+static uint64_t cyder_gdi_profile_begin(void)
+{
+    LARGE_INTEGER time;
+    InitOnceExecuteOnce(&cyder_gdi_profile_once, cyder_gdi_profile_init, NULL, NULL);
+    if (cyder_gdi_profile_file == INVALID_HANDLE_VALUE) return 0;
+    QueryPerformanceCounter(&time);
+    return time.QuadPart;
+}
+
+static void cyder_gdi_profile_record(HWND window, HDC dc, int x, int y, int width, int height,
+        int src_width, int src_height, DWORD rop, unsigned api, uint64_t begin, BOOL success)
+{
+    LARGE_INTEGER end;
+    RECT client = {0};
+    char row[256];
+    int size;
+    if (!begin || !window) return;
+    QueryPerformanceCounter(&end);
+    NtUserGetClientRect(window, &client, 0);
+    size = snprintf(row, sizeof(row), "%llu,%llu,%lu,%p,%d,%d,%d,%d,%ld,%ld,%d,%u,%d,%d,%d,%lu\n",
+            (unsigned long long)begin, (unsigned long long)end.QuadPart, GetCurrentThreadId(), window,
+            x, y, width, height, client.right - client.left, client.bottom - client.top,
+            success ? 0 : -1, api, src_width, src_height, GetStretchBltMode(dc), rop);
+    if (size <= 0 || (size_t)size >= sizeof(row)) return;
+    AcquireSRWLockExclusive(&cyder_gdi_profile_lock);
+    if (cyder_gdi_profile_file != INVALID_HANDLE_VALUE)
+    {
+        if (cyder_gdi_profile_used + size > sizeof(cyder_gdi_profile_buffer))
+        {
+            if (!cyder_gdi_profile_write(cyder_gdi_profile_buffer, cyder_gdi_profile_used))
+                goto done;
+            cyder_gdi_profile_used = 0;
+        }
+        memcpy(cyder_gdi_profile_buffer + cyder_gdi_profile_used, row, size);
+        cyder_gdi_profile_used += size;
+    }
+done:
+    ReleaseSRWLockExclusive(&cyder_gdi_profile_lock);
+}
+
+/* DLL_PROCESS_DETACH: other process threads may already be gone holding locks.
+ * Do not acquire a lock or allocate here. Incomplete records are never counted. */
+void cyder_gdi_profile_close(void)
+{
+    if (cyder_gdi_profile_file == INVALID_HANDLE_VALUE) return;
+    if (cyder_gdi_profile_used)
+        cyder_gdi_profile_write(cyder_gdi_profile_buffer, cyder_gdi_profile_used);
+    if (cyder_gdi_profile_file != INVALID_HANDLE_VALUE) CloseHandle(cyder_gdi_profile_file);
+    cyder_gdi_profile_file = INVALID_HANDLE_VALUE;
+    cyder_gdi_profile_used = 0;
+}
+#endif
