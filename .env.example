# Product floor for host Mach-O (wine, wineserver, *.so, bundled dylibs).
# Copy to .env and adjust if needed. Missing .env → scripts default to 10.15.
MACOSX_DEPLOYMENT_TARGET=10.15
# Graphics builds separately default to MOLTENVK_DEPLOYMENT_TARGET=12.0.
# Export that variable for build-graphics-stack.sh; it is not read from .env.
# Both versioned MoltenVK reals require macOS 12+; the host shim stays at 10.15.
